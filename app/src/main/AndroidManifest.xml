<?xml version="1.0" encoding="utf-8"?>
<!--
  Common manifest for all flavors. Only store-safe permissions live here.
  High-risk uses-permissions (SMS, all-files access, VPN) are effectively
  absent in all three flavors: the base manifest never declares them, and the
  play overlay adds 6x tools:node="remove" anchors as a drift guard; a11y
  service is declared only in src/foss + src/github overlays (service
  hardening relies on DEX superclass + xmltree gates).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- #14 SET_ALARM 發送端權限：接收端的 SET_ALARM handler 保護「呼叫端」，
         發送 App 未持有即在 startActivity 遭 SecurityException（normal 級，
         Play 無需申報）。完整理由與 <queries> 可見性契約：
         docs/specs/ANDROID_INTENT_VISIBILITY.md -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- 零新增權限契約（Issue #137 C1/C2）：防範任何 transitive AAR 依賴
         （如 github flavor 的 azure-speech sdk）意外合入 RECORD_AUDIO。
         本 App 語音錄製一律走系統 RecognizerIntent 委派，永遠不直接持有 RECORD_AUDIO。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />

    <!-- queries 可見性（S2 語音 + #14 intent adapter）：targetSdk 36 package
         visibility 會把未宣告的隱式 Intent 過濾掉，resolve-first launcher 即
         resolve null＝必然假 NO_HANDLER（static check 已宣稱 NATIVE，屬契約
         自相矛盾）。逐條理由、MIME 對應與刻意不宣告清單（launch-app 按
         LaunchAppTool KDoc 缺口註記／DELETE）：docs/specs/ANDROID_INTENT_VISIBILITY.md -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.settings.SOUND_SETTINGS" />
        </intent>
        <!-- C1b fallback queryIntentActivities-first 契約：openFallback 先
             queryIntentActivities 全枚舉再 setComponent explicit 啟動，
             VOICE_INPUT_SETTINGS 須列 queries（startActivity 本身不需 queries，
             queryIntentActivities 可見性需要——非 resolveActivity：多候選無預設時
             resolveActivity 回傳系統 Resolver 本身，FLAG_SYSTEM 檢查會誤判）。 -->
        <intent>
            <action android:name="android.settings.VOICE_INPUT_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".LibrePocketApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.LibrePocket"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- D06 最小版系統入口（P6）：僅 intent-filter，無新增權限。
                 ASSIST = 預設助手/助手手勢喚起；理由：同一 Runtime 續接會話。
                 SEND(text/plain) = 系統分享接收；理由：分享正文歸一為 UserTurn。
                 後台喚起一律經 EntryGate 需使用者手勢，無背景啟動濫用。 -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- C1 系統預設助理（Issue #137 C1a，三 flavor 共用，無新增權限；
             play 不加 a11y service overlay：本 PR 完全不碰 a11y）。
             VoiceInteractionService：BIND_VOICE_INTERACTION 門檻＋
             VoiceInteractionService action＋android.voice_interaction meta-data。
             人類 review #4：三服務一律 android:process=":voice"，與主 App process
             分離；好處是隔離（voice crash/OOM 不拖垮主 process、系統可獨立回收），
             非省總記憶體（多一份 ART + Application 實例，總 PSS 增加）。
             註：LibrePocketApp.onCreate 在 :voice 仍執行，但 SkillInstaller
             清理僅 main process 執行（見 LibrePocketApp 進程閘門；:voice 跳過
             並記 log，避免與主行程安裝窗口併發）。三 flavor 共用 main
             manifest，本 PR 無需 flavor overlay。
             C1 三服務同 :voice（stub 無狀態）；C2 接 UI/STT 前將 SessionService（+Recognition）另開 :voice_session 並測量 PSS/啟動時延。TODO(C2-voice-process)。 -->
        <service
            android:name=".assistant.LibreVoiceInteractionService"
            android:exported="true"
            android:process=":voice"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction" />
        </service>
        <service
            android:name=".assistant.LibreVoiceInteractionSessionService"
            android:exported="true"
            android:process=":voice"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionSessionService" />
            </intent-filter>
        </service>
        <service
            android:name=".assistant.LibreRecognitionService"
            android:exported="true"
            android:process=":voice"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
