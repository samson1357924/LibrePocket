<?xml version="1.0" encoding="utf-8"?>
<!--
  D07 hardening: never allow cleartext traffic in release.

  Base config denies cleartext for all domains (including user-added CAs'
  cleartext fallback). Debug builds overlay src/debug/res/xml/
  network_security_config.xml, which additionally permits loopback +
  emulator-host cleartext so LlmProvider.validateBaseUrl's http:// dev
  allowlist can connect; LAN entries must never land here (use adb reverse).
  Release artifacts always use THIS file (asserted by play_policy_check.sh).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
