<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay (replaces main network_security_config in debug builds).

  Release keeps the main config (cleartext denied everywhere). Debug additionally
  permits cleartext to loopback + the emulator host loopback so that
  LlmProvider.validateBaseUrl's http:// allowlist (localhost / 127.0.0.1 /
  10.0.2.2) actually connects at runtime instead of throwing
  CleartextNotPermittedException. LAN hosts (192.168.x / 10.x) stay denied:
  reach them via `adb reverse` or an explicit entry added here temporarily.

  The Play policy gate (scripts/play_policy_check.sh) only asserts on the MAIN
  config, so this file can never weaken a release artifact.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
