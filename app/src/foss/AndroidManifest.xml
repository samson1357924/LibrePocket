<?xml version="1.0" encoding="utf-8"?>
<!--
  Foss flavor overlay (F-Droid / direct download, fully open-source).
  Decision (locked): NO SMS, NO MANAGE_EXTERNAL_STORAGE, NO VPN in any
  flavor. Foss adds ONLY the accessibility automation service (default off,
  two-step consent), symmetric with the src/github overlay.
  See CAPABILITY_MATRIX §1-§2 + BACKLOG D15.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name=".foss.FossAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
