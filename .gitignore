local.properties
# Release signing: keystores + passwords must NEVER be committed.
.env
.env.*
google-services.json
/keystores/
*.jks
*.p12
*.keystore
# Real production signer-pin registries must NEVER be committed (Issue #12);
# only scripts/release_signer_pins.example.json (placeholder negative control) is tracked.
release_signer_pins.json
release_signer_pins.yaml
release_signer_pins.yml
release_signer_pins.toml
release_signer_pins.txt
# Built artifacts (covered by /build/ too, belt and suspenders for strays).
*.apk
*.aab
# Local verification/device logs must never be committed (explicit filename patterns only, not blanket *.log).
device_*.log
verify_*.log
# Python bytecode from policy scripts (local runs set PYTHONDONTWRITEBYTECODE=1;
# some CI steps invoke python directly, so their bytecode artifacts are ignored here).
__pycache__/
*.pyc
