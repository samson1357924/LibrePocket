<?xml version="1.0" encoding="utf-8"?>
<!--
  D07 backup rules (legacy full-backup path, API <= 30 and Auto Backup).

  Principle: API keys are NEVER backed up. A restored device must re-enter
  provider keys (see BackupPolicy.KEY_FILES_EXCLUDED). Sessions, prefs and
  audit rows travel; key files and the DataStore vault do not.

  File inventory (see EncryptedPrefsVault.PREFS_FILE):
  - sharedpref/librepocket_keys.xml ........... EncryptedSharedPreferences key file
  - database/librepocket_vault ............... future DataStore/Tink vault DB
  - database/librepocket_vault-wal/-shm ...... its SQLite WAL sidecars (separate files!)
  - files/librepocket_keysets/ ............... future Tink keyset DIRECTORY
      (backup `path` is an exact file-or-directory match, NOT a glob/prefix:
      a whole directory must be excluded, never a filename prefix)

  Contract: Tink keysets MUST be created under files/librepocket_keysets/.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="librepocket_keys.xml" />
    <exclude domain="database" path="librepocket_vault" />
    <exclude domain="database" path="librepocket_vault-wal" />
    <exclude domain="database" path="librepocket_vault-shm" />
    <exclude domain="file" path="librepocket_keysets" />
</full-backup-content>
