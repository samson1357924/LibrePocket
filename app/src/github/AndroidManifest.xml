<?xml version="1.0" encoding="utf-8"?>
<!--
  GitHub flavor overlay (direct download only, never Play).
  Decision (locked): NO SMS, NO MANAGE_EXTERNAL_STORAGE, NO VPN in any
  flavor. GitHub adds ONLY the accessibility automation service (default off,
  two-step consent). See CAPABILITY_MATRIX「Current：可確認的邊界」+ BACKLOG B5.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          B1 Shizuku binder 通道（Shizuku 13.x 標準接線，僅 github 風味）。
          authorities 固定為 "<package>.shizuku"（ShizukuProvider 以
          getPackageName() + ".shizuku" 自尋 binder）；exported=true 是
          Shizuku Manager 回傳 binder 的必要條件。play/foss 源集無此宣告，
          對應 artifact gate 維持 fail-closed。
          禁止加 permission（Shizuku 上游要求 exported，不另加 signature
          permission；鑑權在 Manager 側），以免後人誤加固斷連。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />
        <service
            android:name=".github.GithubAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
