<?xml version="1.0" encoding="utf-8"?>
<!--
  A5 (Issue #135) LAN overlay — FOSS flavor only. Replaces main's
  network_security_config in foss builds (fossRelease; fossDebug is overridden
  by the stricter src/debug overlay, which allows loopback only).

  Android NSC has NO CIDR syntax: 10/8, 172.16/12 and 192.168/16 cannot be
  expressed as ranges. Cleartext is therefore enabled ONLY for the enumerated
  loopback aliases and explicit RFC1918 host literals below; every <domain>
  sets includeSubdomains="false". Public http, CGNAT (100.64/10), link-local /
  metadata addresses and wildcard-looking names stay denied, and are rejected
  by scripts/nsc_check.py in lan mode if anyone adds them here.

  This is a PLATFORM-level permission only. The app-level NetworkPolicy still
  defaults to HTTPS_ONLY: no private IP or http:// endpoint is reachable until
  an explicit per-endpoint opt-in is confirmed. Play never ships this resource
  (app/src/play has no NSC overlay), so play keeps deny-all in every build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">172.16.0.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
    </domain-config>
</network-security-config>
