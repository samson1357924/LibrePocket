<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher theme: SplashScreen wrapper so cold start isn't a bare white flash.
         Compose (LibrePocketTheme) takes over after setContent. -->
    <style name="Theme.LibrePocket" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <!-- TODO: replace with branded @mipmap/ic_launcher once adaptive icon lands. -->
        <item name="windowSplashScreenAnimatedIcon">@android:mipmap/sym_def_app_icon</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
    </style>
</resources>
