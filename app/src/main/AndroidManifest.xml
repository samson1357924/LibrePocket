<?xml version="1.0" encoding="utf-8"?>
<!--
  Common manifest for all flavors. Only store-safe permissions live here.
  High-risk uses-permissions (SMS, all-files access, VPN) are effectively
  absent in all three flavors: the base manifest never declares them, and the
  play overlay adds 6x tools:node="remove" anchors as a drift guard; a11y
  service is declared only in src/foss + src/github overlays (service
  hardening relies on DEX superclass + xmltree gates).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- #14 SET_ALARM 發送端權限（官方 Common Intents 契約）：接收端 activity 的
         `android:permission="com.android.alarm.permission.SET_ALARM"` 限制的是
         「呼叫端」——Google Clock / AOSP DeskClock 的 SET_ALARM handler 以此權限
         保護，發送 App 未持有會在 startActivity 被 SecurityException 拒絕。此為
         normal 級權限（安裝即自動授權、非高風險，Play 不需申報或 Data Safety 披露）。 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- S2 系統語音辨識：委託系統 RecognizerIntent（無 RECORD_AUDIO 新權限）。
         queries 僅宣告可見性，供 PackageManager 解析辨識服務；
         action 必須是 RECOGNIZE_SPEECH（與 VoiceStt.ACTION 同字面值），
         不可用 RecognitionService（服務類名，非 intent action，解析不到）；
         無服務時 ChatScreen 降級手動輸入（NO_PRIVILEGE）。
         S2 系統語音輸出：TTS_SERVICE 可見性供 getEngines() 引擎探測；
         targetSdk 36 package-visibility 過濾下若缺此宣告，引擎表可能為空
         而被誤判 NO_ENGINE。 -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- #14 Intent adapter（鬧鐘/日曆）：targetSdk 36 下 API 30+ package
             visibility 會把未宣告的隱式 Intent 過濾掉，使 resolveActivity 回 null
             而被誤判為 NO_HANDLER；故補最小可見性（只有本塊三項，不擴大到
             導航/開 App/音樂——見各工具 KDoc 的缺口註記）。
             - SET_ALARM：執行期 Intent 無 data，action-only 即可匹配時鐘 App。
             - INSERT/EDIT：執行期帶 content URI 但無顯式 type；以
               CalendarContract.Events.CONTENT_TYPE（dir/event）/
               CONTENT_ITEM_TYPE（item/event）匹配日曆 App 過濾器；queries 的
               path 屬性一律視為 *，故不寫 data URI。
             刻意不宣告 DELETE（不經 launcher 發射，僅待寫描述）。SET_ALARM 發送端
             權限見上方 uses-permission（官方契約要求，非宣告即被拒）。
             直啟（setPackage）不採用：OEM 時鐘/日曆包名各異，硬編碼等於猜測
             包名（#19 猜測執行禁令），且剝奪使用者選擇器。 -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
    </queries>

    <application
        android:name=".LibrePocketApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.LibrePocket"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- D06 最小版系統入口（P6）：僅 intent-filter，無新增權限。
                 ASSIST = 預設助手/助手手勢喚起；理由：同一 Runtime 續接會話。
                 SEND(text/plain) = 系統分享接收；理由：分享正文歸一為 UserTurn。
                 後台喚起一律經 EntryGate 需使用者手勢，無背景啟動濫用。 -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
