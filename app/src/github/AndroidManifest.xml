<?xml version="1.0" encoding="utf-8"?>
<!--
  GitHub flavor overlay (direct download only, never Play).
  Decision (locked): NO SMS, NO MANAGE_EXTERNAL_STORAGE, NO VPN in any
  flavor. GitHub adds ONLY the accessibility automation service (default off,
  two-step consent). See CAPABILITY_MATRIX「Current：可確認的邊界」+ BACKLOG B5.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          #136-B1 Shizuku binder 通道（Shizuku 13.x 官方合約，僅 github 風味；
          見 RikkaApps/Shizuku-API `ShizukuProvider.java` 與 README）。
          authorities 固定為 "${applicationId}.shizuku"（ShizukuProvider 以
          getPackageName() + ".shizuku" 自尋 binder）；exported="true" 與
          multiprocess="false" 為上游 ShizukuProvider.attachInfo() 硬性契約。
          必須宣告 android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"：
          防止一般第三方 App 存取 sendBinder / getBinder，同時讓
          shizuku_server（com.android.shell / root）與本 App 自身 UID 仍可存取；
          切勿改為自訂 app signature permission（會導致 shizuku_server 無法回傳 binder 而斷連）。
          play/foss 源集無此宣告，對應 artifact gate 維持 fail-closed。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <service
            android:name=".github.GithubAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
